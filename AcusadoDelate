local function crearBoton(texto, posY)
    local btn = Instance.new("TextButton", mainFrame)
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, posY)
    btn.Text = texto
    btn.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(210, 210, 210)
    stroke.Thickness = 1
    return btn
end

local btnClickDelete = crearBoton("CLICK DELETE: OFF", 45)
local btnRestaurar = crearBoton("DEVOLVER TODO ATRÁS", 95)
local btnDeshacer = crearBoton("DESHACER ÚLTIMO BORRADO", 145)

-----------------------------------------------------------
-- LÓGICA DE BORRADO Y RESTAURACIÓN
-----------------------------------------------------------
local borradoActivo = false
local historialBorrados = {}

-- Anti Borrado de Calle
local function esParteDeCalle(target)
    if not target or not target.Parent then return true end
    
    local name = target.Name:lower()
    local parentName = target.Parent.Name:lower()

    if name:find("road") or name:find("street") or name:find("calle") or 
       name:find("pisa") or name:find("piso") or name:find("asfalto") or 
       name:find("sidewalk") or name:find("acera") or name:find("ground") or
       parentName:find("road") or parentName:find("street") or parentName:find("map") or
       (target:IsA("BasePart") and target.Size.X > 35 and target.Size.Z > 35 and target.Size.Y < 4) then
        return true
    end
    return false
end

-- Toggle Activar
btnClickDelete.MouseButton1Click:Connect(function()
    borradoActivo = not borradoActivo
    if borradoActivo then
        btnClickDelete.Text = "CLICK DELETE: ON (ACTIVADO)"
        btnClickDelete.BackgroundColor3 = Color3.fromRGB(220, 255, 220)
    else
        btnClickDelete.Text = "CLICK DELETE: OFF"
        btnClickDelete.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    end
end)

-- Borrado al hacer clic (Mueve a carpeta oculta)
mouse.Button1Down:Connect(function()
    if not borradoActivo then return end
    
    pcall(function()
        local target = mouse.Target
        
        if target and target.Parent and player.Character and not target:IsDescendantOf(player.Character) then
            if esParteDeCalle(target) then return end

            local objetoABorrar = target
            if target.Parent:IsA("Model") and not target.Parent:IsA("Workspace") then
                objetoABorrar = target.Parent
            end

            table.insert(historialBorrados, {
                objeto = objetoABorrar,
                padreOriginal = objetoABorrar.Parent
            })

            -- Lo manda al almacenamiento oculto
            objetoABorrar.Parent = storageFolder
        end
    end)
end)

-- DEVOLVER TODO ATRÁS (Restaura todo lo borrado)
btnRestaurar.MouseButton1Click:Connect(function()
    pcall(function()
        for i = #historialBorrados, 1, -1 do
            local item = historialBorrados[i]
            if item and item.objeto and item.padreOriginal then
                item.objeto.Parent = item.padreOriginal
            end
        end
        historialBorrados = {}
    end)
    btnRestaurar.Text = "¡TODO DEVUELTO!"
    task.wait(1)
    btnRestaurar.Text = "DEVOLVER TODO ATRÁS"
end)

-- DESHACER ÚLTIMO
btnDeshacer.MouseButton1Click:Connect(function()
    if #historialBorrados > 0 then
        local ultimo = table.remove(historialBorrados, #historialBorrados)
        pcall(function()
            if ultimo and ultimo.objeto and ultimo.padreOriginal then
                ultimo.objeto.Parent = ultimo.padreOriginal
            end
        end)
    end
end)
