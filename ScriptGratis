local function GiveDeleteTool()
    pcall(function()
        if not L_Plr.Backpack:FindFirstChild("ACUSADO") then
            local Tool = Instance.new("Tool")
            Tool.Name = "ACUSADO"
            Tool.RequiresHandle = false
            Tool.Parent = L_Plr.Backpack
            Tool.Activated:Connect(function()
                local Mouse = L_Plr:GetMouse()
                if Mouse.Target then
                    pcall(function() Mouse.Target:Destroy() end)
                end
            end)
        end
    end)
end

LoginBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == "ACUSADO" then
        LoginFrame:Destroy()
        MainFrame.Visible = true
        ToggleBtn.Visible = true
    else
        LoginBtn.Text = "KEY INCORRECTA"
        LoginBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
        task.wait(1)
        LoginBtn.Text = "ENTRAR"
        LoginBtn.BackgroundColor3 = AccentBlue
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    ToggleBtn.Text = MainFrame.Visible and "❌" or "🥷"
end)

FarmBtn.MouseButton1Click:Connect(function()
    farmActive = not farmActive
    if farmActive then
        FarmBtn.Text = "STOP FARM"
        FarmBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
        StatusLabel.Text = "STATUS: 🥷 MODO NINJA ACTIVO"
        
        GiveDeleteTool()
        
        task.spawn(function()
            while farmActive do
                local foundAny = false
                pcall(function()
                    for _, itemName in ipairs(items) do
                        if not farmActive then break end
                        local char = L_Plr.Character
                        local tool = L_Plr.Backpack:FindFirstChild(itemName) or (char and char:FindFirstChild(itemName))
                        
                        if tool and char and char:FindFirstChild("Humanoid") then
                            foundAny = true
                            char.Humanoid:EquipTool(tool)
                            task.wait(0.3)
                            
                            vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                            task.wait(0.1)
                            vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                            
                            task.wait(0.2)
                            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                            task.wait(0.1)
                            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                            task.wait(1.5)
                        end
                    end
                end)
                
                if not foundAny and farmActive then
                    StatusLabel.Text = "STATUS: ❌ BUSCANDO INGREDIENTES..."
                end
                task.wait(0.5)
            end
        end)
    else
        FarmBtn.Text = "START AUTO-FARM"
        FarmBtn.BackgroundColor3 = AccentBlue
        StatusLabel.Text = "STATUS: DETENIDO"
    end
end)

