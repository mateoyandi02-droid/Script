-- ACUSADO NINJA HUB (ULTRA SAFE - NO TOYO)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

-- Carpeta oculta para que el juego no la encuentre en los personajes
local ESP_Folder = Instance.new("Folder")
ESP_Folder.Name = "SystemData_" .. math.random(100, 999)
ESP_Folder.Parent = game:GetService("Workspace").CurrentCamera -- Carpeta en la Cámara (Indetectable)

local Config = {
    Enabled = false,
    Color = Color3.fromRGB(255, 0, 0),
    Tag = "GhostOut"
}

-- Función para aplicar el Outline sin meterlo al personaje
local function ApplyESP(player)
    if player == LocalPlayer then return end
    
    local function setup(character)
        if not Config.Enabled then return end
        task.wait(1) -- Espera larga para que el anticheat se relaje

        -- Creamos el Highlight FUERA del personaje (en nuestra carpeta)
        local highlight = ESP_Folder:FindFirstChild(player.Name) or Instance.new("Highlight")
        highlight.Name = player.Name
        highlight.Adornee = character
        highlight.FillTransparency = 1 -- Solo contorno
        highlight.OutlineTransparency = 0
        highlight.OutlineColor = Config.Color
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = ESP_Folder
    end

    player.CharacterAdded:Connect(setup)
    if player.Character then setup(player.Character) end
end

