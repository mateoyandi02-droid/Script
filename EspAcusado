-- Contenedor de Colores
local Colors = Instance.new("Frame", Main)
Colors.Size = UDim2.new(0.9, 0, 0, 70)
Colors.Position = UDim2.new(0.05, 0, 0.42, 0)
Colors.BackgroundTransparency = 1

local function AddC(col, x, y)
    local b = Instance.new("TextButton", Colors)
    b.Size = UDim2.new(0, 20, 0, 20)
    b.Position = UDim2.new(0, x, 0, y)
    b.BackgroundColor3 = col
    b.Text = ""
    local corner = Instance.new("UICorner", b)
    corner.CornerRadius = UDim.new(1, 0)
    
    b.MouseButton1Click:Connect(function()
        Config.Color = col
        for _, h in pairs(ESP_Folder:GetChildren()) do
            if h:IsA("Highlight") then h.OutlineColor = col end
        end
    end)
end

-- Fila 1
AddC(Color3.fromRGB(255, 0, 0), 10, 5)     -- Rojo
AddC(Color3.fromRGB(0, 255, 150), 52, 5)   -- Verde
AddC(Color3.fromRGB(0, 150, 255), 94, 5)   -- Azul
