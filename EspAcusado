-- Fila 2 (Nuevos Colores)
AddC(Color3.fromRGB(170, 0, 255), 10, 35)  -- Morado
AddC(Color3.fromRGB(255, 255, 0), 52, 35)  -- Amarillo
AddC(Color3.fromRGB(255, 20, 147), 94, 35) -- Rosado / Neon Pink
AddC(Color3.fromRGB(0, 255, 255), 136, 35) -- Cyan / Turquesa

Toggle.MouseButton1Click:Connect(function()
    Config.Enabled = not Config.Enabled
    Toggle.Text = Config.Enabled and "ESP: ON" or "ESP: OFF"
    Toggle.BackgroundColor3 = Config.Enabled and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(40, 40, 40)
    
    if Config.Enabled then
        for _, pl in pairs(Players:GetPlayers()) do ApplyESP(pl) end
    else
        ESP_Folder:ClearAllChildren()
    end
end)

Players.PlayerAdded:Connect(ApplyESP)
