-- Función creadora de filas
local function crearFila(nombre, posY)
    local lblName = Instance.new("TextLabel", mainFrame)
    lblName.Size = UDim2.new(0, 120, 0, 25)
    lblName.Position = UDim2.new(0, 12, 0, posY)
    lblName.Text = nombre
    lblName.TextColor3 = Color3.fromRGB(200, 200, 200)
    lblName.Font = Enum.Font.Gotham
    lblName.TextSize = 13
    lblName.BackgroundTransparency = 1
    lblName.TextXAlignment = Enum.TextXAlignment.Left

    local lblVal = Instance.new("TextLabel", mainFrame)
    lblVal.Size = UDim2.new(0, 60, 0, 25)
    lblVal.Position = UDim2.new(1, -72, 0, posY)
    lblVal.Text = "0"
    lblVal.TextColor3 = Color3.fromRGB(255, 255, 255)
    lblVal.Font = Enum.Font.GothamBold
    lblVal.TextSize = 14
    lblVal.BackgroundTransparency = 1
    lblVal.TextXAlignment = Enum.TextXAlignment.Right

    return lblVal
end

local valSmall = crearFila("Small Bag", 55)
local valMedium = crearFila("Medium Bag", 95)
local valLarge = crearFila("Large Bag", 135)

