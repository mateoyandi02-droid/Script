-- Fila del Total
local lblTotalTitle = Instance.new("TextLabel", mainFrame)
lblTotalTitle.Size = UDim2.new(0, 80, 0, 30)
lblTotalTitle.Position = UDim2.new(0, 12, 0, 185)
lblTotalTitle.Text = "TOTAL"
lblTotalTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
lblTotalTitle.Font = Enum.Font.GothamBold
lblTotalTitle.TextSize = 15
lblTotalTitle.BackgroundTransparency = 1
lblTotalTitle.TextXAlignment = Enum.TextXAlignment.Left

local lblTotalVal = Instance.new("TextLabel", mainFrame)
lblTotalVal.Size = UDim2.new(0, 100, 0, 30)
lblTotalVal.Position = UDim2.new(1, -112, 0, 185)
lblTotalVal.Text = "$0"
lblTotalVal.TextColor3 = Color3.fromRGB(255, 255, 255)
lblTotalVal.Font = Enum.Font.GothamBold
lblTotalVal.TextSize = 16
lblTotalVal.BackgroundTransparency = 1
lblTotalVal.TextXAlignment = Enum.TextXAlignment.Right

-- Precios aproximados para cálculo del total
local PRECIO_SMALL = 1470
local PRECIO_MEDIUM = 2940
local PRECIO_LARGE = 5880

-- Loop de actualización automática
task.spawn(function()
    while counterGui.Parent do
        pcall(function()
            local smallCount, mediumCount, largeCount = 0, 0, 0
            
            local inv = player.Backpack:GetChildren()
            if player.Character then
                for _, child in pairs(player.Character:GetChildren()) do
                    if child:IsA("Tool") then
                        table.insert(inv, child)
                    end
                end
            end

            for _, item in pairs(inv) do
                local name = item.Name
                if name:find("Small") then
                    smallCount = smallCount + 1
                elseif name:find("Medium") then
                    mediumCount = mediumCount + 1
                elseif name:find("Large") then
                    largeCount = largeCount + 1
                end
            end

            valSmall.Text = tostring(smallCount)
            valMedium.Text = tostring(mediumCount)
            valLarge.Text = tostring(largeCount)

            local totalMoney = (smallCount * PRECIO_SMALL) + (mediumCount * PRECIO_MEDIUM) + (largeCount * PRECIO_LARGE)
            lblTotalVal.Text = "$" .. tostring(totalMoney)
        end)
        task.wait(0.5)
    end
end)
