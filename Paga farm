-- [[ ACUSADO NINJA HUB MASHMELLOW - ACUSADO DOMINA EDITION ]] --
-- LÓGICA ORIGINAL INTACTA | DISEÑO BLANCO Y NEGRO | SIN SINTAXIS ROTA

local _K = "BACK01"
local lp = game:GetService("Players").LocalPlayer
local vim = game:GetService("VirtualInputManager")
local vu = game:GetService("VirtualUser")
local coreGui = game:GetService("CoreGui")

-- Seguridad: Verificación de entorno y camuflaje
local targetParent = lp:FindFirstChild("PlayerGui") or coreGui
local function CleanUI()
    for _, v in pairs(targetParent:GetChildren()) do
        if v:FindFirstChild("AC_TAG_DOMINA") then v:Destroy() end
    end
end
CleanUI()

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RobloxGui"
ScreenGui.Parent = targetParent
ScreenGui.ResetOnSpawn = false
local tag = Instance.new("BoolValue", ScreenGui)
tag.Name = "AC_TAG_DOMINA"

-- [ ESTILO BLANCO Y NEGRO ]
local MainWhite = Color3.fromRGB(255, 255, 255)
local DarkBg = Color3.fromRGB(10, 10, 10)
local CardBg = Color3.fromRGB(22, 22, 22)

-- [ LOGIN: ACUSADO DOMINA ]
local LoginFrame = Instance.new("Frame", ScreenGui)
LoginFrame.Size = UDim2.new(0, 300, 0, 200)
LoginFrame.Position = UDim2.new(0.5, -150, 0.4, -100)
LoginFrame.BackgroundColor3 = DarkBg
Instance.new("UICorner", LoginFrame)
local LStroke = Instance.new("UIStroke", LoginFrame)
LStroke.Color = MainWhite
LStroke.Thickness = 2

local LTitle = Instance.new("TextLabel", LoginFrame)
LTitle.Size = UDim2.new(1, 0, 0, 40)
LTitle.Text = "ACUSADO DOMINA"
LTitle.TextColor3 = MainWhite
LTitle.Font = Enum.Font.GothamBold
LTitle.TextSize = 20
LTitle.BackgroundTransparency = 1

local KeyInput = Instance.new("TextBox", LoginFrame)
KeyInput.Size = UDim2.new(0.8, 0, 0, 40)
KeyInput.Position = UDim2.new(0.1, 0, 0.4, 0)
KeyInput.PlaceholderText = "ENTER KEY"
KeyInput.BackgroundColor3 = CardBg
KeyInput.TextColor3 = Color3.fromRGB(255, 255, 255)
Instance.new("UICorner", KeyInput)

local LoginBtn = Instance.new("TextButton", LoginFrame)
LoginBtn.Size = UDim2.new(0.8, 0, 0, 40)
LoginBtn.Position = UDim2.new(0.1, 0, 0.75, 0)
LoginBtn.BackgroundColor3 = MainWhite
LoginBtn.Text = "VERIFICAR"
LoginBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
LoginBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", LoginBtn)

-- [ HUB CONTROL ]
local function StartHub()
    LoginFrame:Destroy()
    
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 480, 0, 380)
    MainFrame.Position = UDim2.new(0.5, -240, 0.5, -190)
    MainFrame.BackgroundColor3 = DarkBg
    MainFrame.Active = true
    MainFrame.Draggable = true
    Instance.new("UICorner", MainFrame)
    Instance.new("UIStroke", MainFrame).Color = MainWhite

    -- BOTÓN PARA REGRESAR (MINIMIZADO)
    local OpenBtn = Instance.new("TextButton", ScreenGui)
    OpenBtn.Size = UDim2.new(0, 80, 0, 30)
    OpenBtn.Position = UDim2.new(0, 10, 0.5, 0)
    OpenBtn.BackgroundColor3 = DarkBg
    OpenBtn.Text = "ABRIR"
    OpenBtn.TextColor3 = MainWhite
    OpenBtn.Visible = false
    OpenBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", OpenBtn)
    Instance.new("UIStroke", OpenBtn).Color = MainWhite

    local Title = Instance.new("TextLabel", MainFrame)
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Text = "ACUSADO NINJA HUB MASHMELLOW"
    Title.TextColor3 = MainWhite
    Title.Font = Enum.Font.GothamBold
    Title.BackgroundTransparency = 1

    -- BOTÓN CERRAR (X) Y MINIMIZAR (-)
    local CloseBtn = Instance.new("TextButton", MainFrame)
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(1, -35, 0, 5)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = MainWhite
    CloseBtn.Font = Enum.Font.GothamBold

    local MiniBtn = Instance.new("TextButton", MainFrame)
    MiniBtn.Size = UDim2.new(0, 30, 0, 30)
    MiniBtn.Position = UDim2.new(1, -65, 0, 5)
    MiniBtn.BackgroundTransparency = 1
    MiniBtn.Text = "-"
    MiniBtn.TextColor3 = MainWhite
    MiniBtn.Font = Enum.Font.GothamBold

    local InfoLabel = Instance.new("TextLabel", MainFrame)
    InfoLabel.Size = UDim2.new(0.50, 0, 0, 290)
    InfoLabel.Position = UDim2.new(0.04, 0, 0, 60)
    InfoLabel.BackgroundColor3 = CardBg
    InfoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    InfoLabel.Font = Enum.Font.Code
    InfoLabel.TextSize = 11
    InfoLabel.TextXAlignment = Enum.TextXAlignment.Left
    InfoLabel.TextYAlignment = Enum.TextYAlignment.Top
    Instance.new("UICorner", InfoLabel)

    local function CreateBtn(txt, pos)
        local b = Instance.new("TextButton", MainFrame)
        b.Size = UDim2.new(0.40, 0, 0, 55)
        b.Position = pos
        b.BackgroundColor3 = CardBg
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.Font = Enum.Font.GothamBold
        b.Text = txt
        b.TextSize = 11
        Instance.new("UICorner", b)
        return b
    end

    local FarmBtn = CreateBtn("FARM MASHMELLOW", UDim2.new(0.56, 0, 0, 60))
    local SellBtn = CreateBtn("AUTO SELL", UDim2.new(0.56, 0, 0, 135))
    local ToolBtn = CreateBtn("MASHMELLOW TOOL", UDim2.new(0.56, 0, 0, 210))

    local farmActive, sellActive = false, false
    local items = {"Water", "Sugar Block Bag", "Gelatin", "Empty Bag"}

    CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)
    MiniBtn.MouseButton1Click:Connect(function() MainFrame.Visible = false OpenBtn.Visible = true end)
    OpenBtn.MouseButton1Click:Connect(function() MainFrame.Visible = true OpenBtn.Visible = false end)

    -- LÓGICA DE FARM
    FarmBtn.MouseButton1Click:Connect(function()
        farmActive = not farmActive
        FarmBtn.Text = farmActive and "STOP FARM" or "FARM MASHMELLOW"
        FarmBtn.BackgroundColor3 = farmActive and MainWhite or CardBg
        if farmActive then FarmBtn.TextColor3 = Color3.fromRGB(0,0,0) else FarmBtn.TextColor3 = Color3.fromRGB(255,255,255) end
        
        task.spawn(function()
            while farmActive do
                pcall(function()
                    for _, itemName in ipairs(items) do
                        if not farmActive then break end
                        local char = lp.Character
                        local tool = lp.Backpack:FindFirstChild(itemName) or (char and char:FindFirstChild(itemName))
                        if tool and char and char:FindFirstChild("Humanoid") then
                            char.Humanoid:EquipTool(tool)
                            task.wait(0.3)
                            vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                            task.wait(0.1)
                            vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                            task.wait(0.2)
                            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                            task.wait(0.1)
                            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                            task.wait(1.5)
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    end)

    -- AUTO-SELL AUTOMÁTICO
    SellBtn.MouseButton1Click:Connect(function()
        sellActive = not sellActive
        SellBtn.Text = sellActive and "SELLING ON..." or "AUTO SELL"
        SellBtn.BackgroundColor3 = sellActive and MainWhite or CardBg
        if sellActive then SellBtn.TextColor3 = Color3.fromRGB(0,0,0) else SellBtn.TextColor3 = Color3.fromRGB(255,255,255) end
    end)

    -- DELETE TOOL
    ToolBtn.MouseButton1Click:Connect(function()
        local t = Instance.new("Tool", lp.Backpack)
        t.Name = "MASHMELLOW DELETE"
        t.RequiresHandle = false
        t.Activated:Connect(function()
            local m = lp:GetMouse()
            if m.Target then pcall(function() m.Target:Destroy() end) end
        end)
    end)

    -- LOOP DE VENTA AUTOMÁTICA Y PANEL DE ESTADÍSTICAS
    task.spawn(function()
        while task.wait(0.5) do
            local char = lp.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then continue end

            if sellActive then
                pcall(function()
                    for _, i in pairs(lp.Backpack:GetChildren()) do
                        if not sellActive then break end
                        if i.Name:find("Small") or i.Name:find("Medium") or i.Name:find("Large") then
                            char.Humanoid:EquipTool(i)
                            task.wait(0.2)
                            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                            task.wait(0.1)
                            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                            task.wait(0.2)
                        end
                    end
                end)
            end

            -- Actualizar estadísticas de la UI
            local c = {W=0, S=0, G=0, B=0, Sm=0, M=0, L=0}
            local inv = lp.Backpack:GetChildren()
            for _, v in pairs(char:GetChildren()) do table.insert(inv, v) end
            for _, i in pairs(inv) do
                if i.Name == "Water" then c.W=c.W+1 
                elseif i.Name == "Sugar Block Bag" then c.S=c.S+1 
                elseif i.Name == "Gelatin" then c.G=c.G+1 
                elseif i.Name == "Empty Bag" then c.B=c.B+1 
                elseif i.Name:find("Small") then c.Sm=c.Sm+1 
                elseif i.Name:find("Medium") then c.M=c.M+1 
                elseif i.Name:find("Large") then c.L=c.L+1 end
            end

            InfoLabel.Text = string.format([[
  [ ACUSADO MASHMELLOW HUB ]
  DOMINANDO EL SERVIDOR...
  
  PRODUCTOS:
  - Small:   %d
  - Medium:  %d
  - Large:   %d

  MATERIALES:
  - Agua:    %d
  - Azucar:  %d
  - Gelatina:%d
  - Bolsas:  %d

  [ SEGURIDAD ]
  Status: Anti-Ban Active
  Key: Verified
            ]], c.Sm, c.M, c.L, c.W, c.S, c.G, c.B)
        end
    end)
end

LoginBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == _K then StartHub() else LoginBtn.Text = "ERROR" task.wait(1) LoginBtn.Text = "VERIFICAR" end
end)

-- Anti-AFK Seguro
lp.Idled:Connect(function()
    vu:CaptureController()
    vu:ClickButton2(Vector2.new())
end)
