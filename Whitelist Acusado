    -- CREAR TOGGLE PÍLDORA (ESTILO SOLICITADO)
    local function AddTogglePill(cardParent, labelText, targetTable, targetVar)
        local row = Instance.new("Frame", cardParent)
        row.Size = UDim2.new(1, 0, 0, 24)
        row.BackgroundTransparency = 1

        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(1, -50, 1, 0)
        lbl.Position = UDim2.new(0, 0, 0, 0)
        lbl.Text = labelText
        lbl.TextColor3 = TextWhite
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.BackgroundTransparency = 1

        local toggleBtn = Instance.new("TextButton", row)
        toggleBtn.Size = UDim2.new(0, 42, 0, 20)
        toggleBtn.Position = UDim2.new(1, -42, 0.5, -10)
        toggleBtn.Font = Enum.Font.GothamBold
        toggleBtn.TextSize = 9
        Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(1, 0)

        local tStroke = Instance.new("UIStroke", toggleBtn)
        tStroke.Thickness = 1

        local function updateState()
            local active = targetTable[targetVar]
            if active then
                toggleBtn.Text = "ON"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                toggleBtn.TextColor3 = Color3.fromRGB(10, 10, 10)
                tStroke.Color = Color3.fromRGB(255, 255, 255)
            else
                toggleBtn.Text = "OFF"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(28, 33, 45)
                toggleBtn.TextColor3 = Color3.fromRGB(130, 140, 160)
                tStroke.Color = Color3.fromRGB(45, 52, 68)
            end
        end

        updateState()

        toggleBtn.MouseButton1Click:Connect(function()
            targetTable[targetVar] = not targetTable[targetVar]
            updateState()
        end)
    end

